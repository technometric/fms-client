<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Tracking Mobile" android:textSize="26sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <EditText android:id="@+id/server" android:hint="Server (contoh: 192.168.1.10)" android:inputType="textUri" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/port" android:hint="Port" android:text="5055" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/deviceId" android:hint="Device ID / Unique ID" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/interval" android:hint="Interval detik" android:text="15" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/start" android:text="Mulai tracking" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/stop" android:text="Stop tracking" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/status" android:text="Status: berhenti" android:paddingTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
